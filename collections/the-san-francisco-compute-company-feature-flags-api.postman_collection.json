        {
          "id": "96536043-fd84-4151-b006-ee0e93692625",
          "name": "List feature flags scoped to the caller",
          "request": {
            "name": "List feature flags scoped to the caller",
            "description": {
              "content": "> ⚠️ This endpoint is in [public preview](/preview/roadmap).\n\nList every user-visible feature flag whose audience matches the caller, along with whether the caller is currently enrolled and whether the flag is self-enrollable via `POST /v2/feature_flags/{feature_flag}`. Flags with `user_enroll = false` are read-only here. Flags not marked `user_visible` are hidden from this listing entirely.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "preview",
                "v2",
                "feature_flags"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{bearerToken}}"
                }
              ]
            }
          },
