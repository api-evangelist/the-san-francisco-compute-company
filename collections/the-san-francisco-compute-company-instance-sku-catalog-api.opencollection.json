{
  "opencollection": "1.0.0",
  "info": {
    "name": "sfc-api Account Instance SKU Catalog API",
    "version": "0.1.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Instance SKU Catalog",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List instance SKU property catalog",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.sfcompute.com/preview/v2/instance_sku_property_catalog",
            "params": [
              {
                "name": "limit",
                "value": "",
                "type": "query",
                "description": "Maximum number of results to return (1-200, default 50)."
              },
              {
                "name": "starting_after",
                "value": "",
                "type": "query",
                "description": "Cursor for forward pagination (from a previous response's `cursor` field)."
              },
              {
                "name": "ending_before",
                "value": "",
                "type": "query",
                "description": "Cursor for backward pagination."
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "> ⚠️ This endpoint is in [public preview](/preview/roadmap).\n\nList every property key and its allowed values. Use the keys and values here when filling in `requirements` on orders and procurements."
        }
      ]
    }
  ],
  "bundled": true
}