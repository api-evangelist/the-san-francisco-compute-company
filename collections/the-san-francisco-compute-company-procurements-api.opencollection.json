            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.sfcompute.com/preview/v2/procurements",
            "params": [
              {
                "name": "workspace",
                "value": "",
                "type": "query",
                "description": "Scope the returned list to a single workspace (ID, resource path, or name). Without it, the returned list spans every workspace the caller has requisite permissions on."
              },
              {
                "name": "pool",
                "value": "",
                "type": "query",
                "description": "Filter by pool."
              },
              {
                "name": "limit",
                "value": "",
                "type": "query"
              },
              {
                "name": "starting_after",
                "value": "",
                "type": "query"
              },
              {
                "name": "ending_before",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "> ⚠️ This endpoint is in [public preview](/preview/roadmap).\n\nList all procurements."
        },
        {
          "info": {
            "name": "Create procurement",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.sfcompute.com/preview/v2/procurements",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "> ⚠️ This endpoint is in [public preview](/preview/roadmap).\n\nCreate a market automation that maintains capacity by placing buy/sell orders."
        },
        {
          "info": {
            "name": "Get procurement",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.sfcompute.com/preview/v2/procurements/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "> ⚠️ This endpoint is in [public preview](/preview/roadmap).\n\nRetrieve a procurement by ID or name."
        },
        {
          "info": {
            "name": "Update procurement",
            "type": "http"
          },
          "http": {
            "method": "PATCH",
            "url": "https://api.sfcompute.com/preview/v2/procurements/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "> ⚠️ This endpoint is in [public preview](/preview/roadmap).\n\nUpdate a procurement's configuration."
        },
        {
          "info": {
            "name": "Delete procurement",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://api.sfcompute.com/preview/v2/procurements/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "> ⚠️ This endpoint is in [public preview](/preview/roadmap).\n\nDelete a procurement. Standing orders are cancelled automatically."
        }
      ]
    }
  ],
  "bundled": true
}