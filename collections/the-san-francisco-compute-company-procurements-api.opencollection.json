{
  "opencollection": "1.0.0",
  "info": {
    "name": "sfc-api Account Procurements API",
    "version": "0.1.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Procurements",
        "type": "folder"
      },
      "items": [
